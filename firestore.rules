rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if caller is an authorized administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'alfielynard23@gmail.com' ||
        request.auth.token.email == 'alfielynardrosalita@gmail.com'
      );
    }

    // User root document (Profile, Preferences & Settings)
    match /users/{userId} {
      allow create, update: if true;
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // User Schedules subcollection
      match /schedules/{scheduleId} {
        allow create, update: if true;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // User Custom Profiles subcollection
      match /profiles/{profileId} {
        allow create, update: if true;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // User Notifications subcollection
      match /notifications/{notificationId} {
        allow create, update: if true;
        allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // In-App User Feedback collection (allow users/guests to submit feedback)
    match /user_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Anonymous AI Training Telemetry Dataset collection
    match /ai_training_samples/{sampleId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Dynamic Institutions & Workplace Directory (Public Read, Admin Write)
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Remote Broadcast Announcements & In-App Banners (Public Read, Admin Write)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Remote App Config & Feature Flags (Public Read, Admin Write)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
